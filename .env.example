# Generate a strong value; never commit the real file.
ANKIWEB_PASSWORD=change-me

# When HTTPS terminates at the app-facing origin, enable Secure cookies.
ANKIWEB_SECURE_COOKIE=false

# Optional alternative: omit ANKIWEB_PASSWORD and inject an Argon2id hash instead.
# ANKIWEB_PASSWORD_HASH=$argon2id$...

# The server refuses to start without a password. Only on an already-isolated host
# (loopback/VPN) you may opt out explicitly:
# ANKIWEB_AUTH_DISABLED=1

# --- LAN HTTPS (docker compose --profile lan up -d) ---
# Address the proxy binds and the name on its certificate. Must be an IP of this host.
# ANKIWEB_LAN_BIND=192.168.1.7
# ANKIWEB_LAN_HOST=192.168.1.7
# Behind TLS, set ANKIWEB_SECURE_COOKIE=true (above) so cookies are Secure and HSTS is sent.
