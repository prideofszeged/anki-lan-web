        "summary": "List Decks",
        "tags": [
          "decks"
        ]
      }
    },
    "/api/v1/decks/{deck_id}": {
      "get": {
        "operationId": "get_deck_api_v1_decks__deck_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "deck_id",
            "required": true,
            "schema": {
              "title": "Deck Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckDetailBody"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "deck not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Deck",
        "tags": [
          "decks"
        ]
      }
    },
